			(justify left top)
		)
		(uuid "16c16ab6-3d4f-4263-8cee-d38b429823dc")
	)
	(text "VC1 and VC2 are mechanically ganged with VC3/VC4.\nFactory AFC series C11 and oscillator feedback differ from SAMS.\nUnspecified coil values and factory tube section-to-pin mapping need chassis verification."
		(exclude_from_sim no)
		(at 52.324 49.276 0)
		(effects
