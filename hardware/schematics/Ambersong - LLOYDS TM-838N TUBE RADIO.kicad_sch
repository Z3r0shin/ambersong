	(text "AM_DIODE goes to V6 pins 5 and 6.\nThe complete 12AV6 is on the audio sheet;\nits triode and diodes share cathode pin 2."
		(exclude_from_sim no)
		(at 245.364 59.436 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify left top)
		)
		(uuid "0162c440-faec-4a84-a75c-bd6b9565e98d")
	)
	(text "CHASSIS is circuit common, directly mains referenced in these source drawings.\nAC terminals are the radio input; external EMI filter, isolation and modern audio electronics are outside this sheet.\nVoltages in net names are SAMS nominal identifiers, not guaranteed measured values.\nL18 and L17 were removed by accident, replaced with the external EMI filter."
		(exclude_from_sim no)
		(at 39.624 222.758 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify left top)
		)
		(uuid "1307ed10-61d8-4413-b5d9-f112e85d03cf")
	)
	(text "MODE SUPPLY AND INDICATOR LAMPS"
